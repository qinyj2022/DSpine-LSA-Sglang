  rows.forEach(function (k) {
    var tr = el("tr");
    ALL_COLS.forEach(function (c, i) {
      var v = c.f ? c.f(k) : (c.v(k) === null || c.v(k) === undefined ? "n/a" : String(c.v(k)));
      var td = el("td", { "class": i < 4 ? "l" : "" }, []);
      if (i === 0) { td.className = "l mk"; td.appendChild(glyph(STAGE_INDEX[k.stage], 12)); }
      td.appendChild(document.createTextNode(v));
      tr.appendChild(td);
    });
    tb.appendChild(tr);
  });
  t.appendChild(tb);
  host.appendChild(t);
}

function redraw() { drawRoofline(); drawSol(); }
(function kernelsControl() {
  var sel = $("#f-kernels-table");
  if (!HAS_TRITON) { $("#kernels-controls").style.display = "none"; return; }
  sel.addEventListener("change", function () { kernelsFilter = sel.value; drawAll(); });
})();
redraw(); drawTime(); drawAll();
})();
</script>
