function emptyChart(svg, W, H, msg) {
  svg.setAttribute("viewBox", "0 0 " + W + " " + H);
  S("text", { x: W / 2, y: H / 2, "text-anchor": "middle", "class": "axlab", text: msg }, svg);
}
function placeLabels(svg, items, box) {
  var placed = [];
  items.forEach(function (it) {
    var w = it.text.length * 6.1, h = 12;
    var offs = [[8, -7], [8, 14], [-8 - w, -7], [-8 - w, 14], [8, -20], [8, 26], [-8 - w, -20], [-8 - w, 26]];
    for (var i = 0; i < offs.length; i++) {
      var x = it.x + offs[i][0], y = it.y + offs[i][1];
      var b = { x0: x, x1: x + w, y0: y - h, y1: y + 3 };
      if (b.x0 < box.x0 || b.x1 > box.x1 || b.y0 < box.y0 || b.y1 > box.y1) continue;
      if (placed.some(function (p) { return !(b.x1 < p.x0 || b.x0 > p.x1 || b.y1 < p.y0 || b.y0 > p.y1); })) continue;
      if (it.pts.some(function (p) { return p.x > b.x0 - 5 && p.x < b.x1 + 5 && p.y > b.y0 - 5 && p.y < b.y1 + 5; })) continue;
      placed.push(b);
