  function rowsOf(steps) {
    return steps.map(function (s) { return { step: s.step || "", context: num(s.context), ms: pick(s.median_ms), kernels: s.kernels === "triton" ? "triton" : "cutedsl", follows: s.follows_context }; });
  }
  var mine = rowsOf(RAW.steps || []), theirs = rowsOf(OTHER.steps);
