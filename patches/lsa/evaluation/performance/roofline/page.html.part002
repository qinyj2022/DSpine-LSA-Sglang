      var ao = at(mine, other, step, a.context), bo = at(theirs, other, step, b.context);
      out.push({ step: step, stage: STAGE_OF[step] || "prefill scan", ctx: a.context, mine: a.ms, theirs: b.ms, ratio: b.ms / a.ms, mineOther: ao ? ao.ms : null, theirsOther: bo ? bo.ms : null });
