      var y = m.t + i * RH + RH / 2, si = STAGE_INDEX[r.stage], color = cssVar(si);
      S("line", { x1: 8, x2: W - 8, y1: y + RH / 2, y2: y + RH / 2, "class": "gridline", style: "opacity:0.5" }, svg);
      S("path", { d: shapePath(STAGES[si].shape, 4.5), transform: "translate(16," + y + ")", style: "fill:" + color }, svg);
      S("text", { x: 30, y: y + 4, "class": "nodetxt", text: r.step === "reference gemm" ? "reference gemm (cuBLAS)" : name(r) }, svg);
      var xa = X(r.mine * 1e6), xb = X(r.theirs * 1e6);
