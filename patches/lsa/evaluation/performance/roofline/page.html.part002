}

/* ---------- tooltip ---------- */
var tip = $("#tip");
function showTip(lines, x, y) {
  clear(tip);
  lines.forEach(function (l, i) {
    if (i === 0) tip.appendChild(el("b", {}, [l]));
    else if (Array.isArray(l)) tip.appendChild(el("div", { "class": "r" }, [el("span", {}, [l[0]]), el("span", {}, [l[1]])]));
    else tip.appendChild(el("div", {}, [l]));
  });
  tip.style.display = "block";
  var w = tip.offsetWidth, h = tip.offsetHeight;
  var nx = Math.min(x + 14, window.innerWidth - w - 8), ny = y + 14;
  if (ny + h > window.innerHeight - 8) ny = Math.max(8, y - h - 14);
  tip.style.left = Math.max(8, nx) + "px";
  tip.style.top = ny + "px";
}
function hideTip() { tip.style.display = "none"; }
function attachTip(target, linesFn) {
  target.addEventListener("pointermove", function (e) { showTip(linesFn(), e.clientX, e.clientY); });
  target.addEventListener("pointerleave", hideTip);
  target.addEventListener("focus", function () { var r = target.getBoundingClientRect(); showTip(linesFn(), r.left + r.width / 2, r.top + r.height / 2); });
  target.addEventListener("blur", hideTip);
}
document.addEventListener("keydown", function (e) { if (e.key === "Escape") hideTip(); });

/* ---------- chart scaffolding ---------- */
function makeScale(d0, d1, r0, r1, log) {
  var a = log ? Math.log10(d0) : d0, b = log ? Math.log10(d1) : d1;
  var f = function (v) { var t = log ? Math.log10(v) : v; return r0 + (t - a) / (b - a) * (r1 - r0); };
  f.domain = [d0, d1];
  return f;
}
function logTicks(d0, d1) {
  var out = [];
  for (var e = Math.ceil(Math.log10(d0) - 1e-9); e <= Math.floor(Math.log10(d1) + 1e-9); e++) out.push(Math.pow(10, e));
  return out;
}
function sciLabel(v) { var e = Math.round(Math.log10(v)); return e === 0 ? "1" : e === 1 ? "10" : "1e" + e; }
function flopsTick(v) {
  var e = Math.round(Math.log10(v));
