    if (!rows.length) return emptyChart(svg, W, 120, "No step ran on both GPUs at this context");
    var vals = [];
    rows.forEach(function (r) { vals.push(r.mine * 1e6, r.theirs * 1e6); });
    var lo = Math.pow(10, Math.floor(Math.log10(Math.min.apply(null, vals)))), hi = Math.pow(10, Math.ceil(Math.log10(Math.max.apply(null, vals))));
    if (hi <= lo) hi = lo * 10;
    var X = makeScale(lo, hi, m.l, W - m.r, true), yEnd = m.t + rows.length * RH;
    logTicks(lo, hi).forEach(function (v) {
      [1, 2, 5].forEach(function (f) {
        if (v * f > hi) return;
        S("line", { x1: X(v * f), x2: X(v * f), y1: m.t - 4, y2: yEnd, "class": "gridline", style: f === 1 ? "" : "opacity:0.5" }, svg);
        if (f === 1) S("text", { x: X(v * f), y: yEnd + 16, "text-anchor": "middle", "class": "tick", text: timeTick(v * f) }, svg);
      });
    });
    S("text", { x: (m.l + W - m.r) / 2, y: yEnd + 34, "text-anchor": "middle", "class": "axlab", text: "Median wall time of the step (log scale)" }, svg);
    S("text", { x: W - m.r + 14, y: m.t - 12, "class": "axlab", text: otherLabel + " / " + thisLabel }, svg);
    S("text", { x: 8, y: m.t - 12, "class": "axlab", text: "Step" }, svg);
