  var table = el("table");
  var thead = el("thead"), htr = el("tr", {}, [el("th", {}, ["Measured"])]);
  cols.forEach(function (ctx) { htr.appendChild(el("th", {}, [ctxLabel(ctx)])); });
  thead.appendChild(htr); table.appendChild(thead);
  var data = cols.map(function (ctx) { return aggregate(cardRecords(card, ctx)); });
  var rows = [["Duration", function (a) { return fmtUs(a.ns); }], ["Achieved TFLOP/s", function (a) { return fmtTflops(a.fps); }], ["DRAM GB/s", function (a) { return a.gbps === null ? "n/a" : sig(a.gbps); }], ["SM throughput", function (a) { return pct(a.sm); }], ["DRAM throughput", function (a) { return pct(a.dramPct); }]];
  var tb = el("tbody");
