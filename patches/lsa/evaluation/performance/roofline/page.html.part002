    S("path", { d: shapePath(STAGES[si].shape, 5.5), transform: "translate(" + xt + "," + y + ")", style: "fill:var(--panel);stroke:" + color + ";stroke-width:2" }, svg);
    S("path", { d: shapePath(STAGES[si].shape, 5.5), transform: "translate(" + xc + "," + y + ")", style: "fill:" + color + ";stroke:var(--panel);stroke-width:1" }, svg);
