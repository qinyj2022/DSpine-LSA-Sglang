      S("text", { x: W - m.r + 64, y: y + 4, "class": "tag", text: Math.abs(r.ratio - 1) < 0.03 ? "tie" : r.ratio > 1 ? thisLabel + " faster" : otherLabel + " faster" }, svg);
      var hit = S("rect", { x: 0, y: y - RH / 2, width: W, height: RH, fill: "transparent", tabindex: "0", "aria-label": name(r) + ": " + thisLabel + " " + sig(r.mine) + " ms, " + otherLabel + " " + sig(r.theirs) + " ms" }, svg);
