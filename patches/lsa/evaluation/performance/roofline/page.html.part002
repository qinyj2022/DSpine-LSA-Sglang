}

/* ---------- filters ---------- */
var state = { context: "all", axis: "dram", stages: {}, triton: true };
STAGES.forEach(function (s) { state.stages[s.id] = true; });
(function controls() {
  var sel = $("#f-context");
  sel.appendChild(el("option", { value: "all" }, ["All contexts"]));
  CONTEXTS.forEach(function (c) { sel.appendChild(el("option", { value: String(c) }, [ctxLabel(c)])); });
  sel.addEventListener("change", function () { state.context = sel.value; redraw(); });
  var fs = $("#f-stage");
  STAGES.forEach(function (s, i) {
    var cb = el("input", { type: "checkbox", checked: "checked", id: "st-" + i });
    cb.addEventListener("change", function () { state.stages[s.id] = cb.checked; redraw(); });
    fs.appendChild(el("label", { "class": "chip", "for": "st-" + i }, [cb, glyph(i, 12), s.label]));
  });
  var tcb = $("#f-triton");
  if (!HAS_TRITON) { $("#f-kernels").style.display = "none"; $("#rf-triton-note").style.display = "none"; }
  tcb.addEventListener("change", function () { state.triton = tcb.checked; redraw(); });
  Array.prototype.forEach.call(document.querySelectorAll("input[name=axis]"), function (r) {
    r.addEventListener("change", function () { if (r.checked) { state.axis = r.value; redraw(); } });
  });
})();
function passes(k) {
  if (!state.stages[k.stage]) return false;
  if (k.stage === "anchor") return true;
  return state.context === "all" || String(k.context) === state.context;
}
function triPlotted() { return HAS_TRITON && state.triton ? TRI_POINTS.filter(passes) : []; }
