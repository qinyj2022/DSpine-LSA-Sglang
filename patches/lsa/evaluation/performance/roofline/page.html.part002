function clab(svg, x, y, t) { return txt(svg, x, y, t, "condlab", "middle"); }

function drawPrefill() {
  var svg = $("#flow-prefill"), mid = flowSvg(svg, 1100, 1230);
  var c1 = 100, c2 = 360, c3 = 600, c4 = 960;
  var start = pill(svg, "a chunk: 32,768 index queries and their keys", 560, 30, 470);
  edge(svg, mid, [[560, start.b], [560, 76]]);
  txt(svg, 570, 68, "new keys, index queries [R, 64] bf16", "edgelab");
  maintain(svg, mid, "Maintain the index");
  var design = dn(svg, ["design?"], 560, 290, 96, 36);
  edge(svg, mid, [[560, 188], [560, design.t]]);
  dataLab(svg, 570, 188, design.t, ["bucket centroids [N, 64] bf16"]);

  // Flat
  edge(svg, mid, [[design.l, 290], [c2, 290], [c2, 364]], true);
  clab(svg, 412, 282, "flat");
  var big = dn(svg, ["N >= 32,768", "visible buckets?"], c2, 400, 124, 36);
  edge(svg, mid, [[big.l, 400], [c1, 400], [c1, 476]], true);
  clab(svg, 168, 392, "yes: scan");
  edge(svg, mid, [[big.r, 400], [c3, 400], [c3, 478]], true);
  clab(svg, 542, 392, "no: short");

  var sp = kn(svg, "samplepass", c1, 500), th = kn(svg, "threshold", c1, 590), li = kn(svg, "listing", c1, 680), ls = kn(svg, "listed", c1, 770);
  down(svg, mid, sp, th, ["histograms", "[R, 64] int32"]);
  down(svg, mid, th, li, ["thresholds", "[R] fp32"]);
  down(svg, mid, li, ls, ["listed buckets", "[R, 3p] int32"]);
  var miss = dn(svg, ["did the row's", "bucket scan miss?"], c1, 880, 92, 36);
  down(svg, mid, ls, miss, ["keys", "[R, 3p] int64"]);
  var f1 = kn(svg, "fill", c1, 978);
  down(svg, mid, miss, f1, null, true);
  clab(svg, c1 + 18, 940, "no").setAttribute("text-anchor", "start");
  var dense = kn(svg, "dense", c2, 942);
  edge(svg, mid, [[miss.r, 880], [c2, 880], [c2, dense.t]], true);
  clab(svg, 276, 872, "yes");
  var topk = tn(svg, "torch top-k", "per 256 rows", c2, 1030);
  down(svg, mid, dense, topk, ["scores", "[256, N] fp32"]);
  var inord = kn(svg, "inorder", c2, 1112);
  down(svg, mid, topk, inord, ["picks", "[R, p] int32"]);

  // Short
  var mm = tn(svg, "torch.mm", "scores [R, N]", c3, 500);
  var sl = kn(svg, "shortlisting", c3, 590);
  down(svg, mid, mm, sl, ["scores", "[R, N] fp32"]);
  var f3 = kn(svg, "fill", c3, 680);
  down(svg, mid, sl, f3, ["listed buckets", "[R, 3p] int32"]);

  // Tree or fixed
  edge(svg, mid, [[design.r, 290], [c4, 290], [c4, 358]], true);
  clab(svg, 808, 282, "fixed or tree");
  var m0 = tn(svg, "torch.mm", "start level scores", c4, 380);
  var wk = kn(svg, "widekeep", c4, 470);
  down(svg, mid, m0, wk, ["scores", "[R, 32,768] fp32"]);
  var bm = kn(svg, "beam", c4, 580);
  down(svg, mid, wk, bm, ["kept children", "[R, 2048 x 4] int32"]);
  S("path", { d: "M" + bm.l + "," + (bm.cy - 8) + "H" + (bm.l - 30) + "V" + (bm.cy + 14) + "H" + (bm.l - 2), "class": "arrow", "stroke-dasharray": "6 4", "marker-end": "url(#" + mid + ")" }, svg);
  txt(svg, bm.l - 38, bm.cy + 10, "once per level", "condlab", "end");
  var m1 = tn(svg, "torch.mm", "uncovered buckets", c4, 690);
  down(svg, mid, bm, m1, ["level 0 children", "[R, 2048 x 4] int32"]);
  var pk = kn(svg, "pick", c4, 790);
  down(svg, mid, m1, pk, ["uncovered scores", "[R, uncovered] fp32"]);
  var f4 = kn(svg, "fill", c4, 890);
  down(svg, mid, pk, f4, ["picked buckets", "[R, p] int64"]);

  // End
  var end = pill(svg, "read list [R, 4,612] int32 -> sparse attention", 560, 1190, 470);
  edge(svg, mid, [[c1, f1.b], [c1, 1190], [end.l, 1190]]);
  dataLab(svg, c1 + 9, f1.b, 1190, ["read list", "[R, 4,612] int32"]);
  edge(svg, mid, [[c2, inord.b], [c2, end.t]]);
  txt(svg, c2 + 9, 1157, "read list [R, 4,612]", "edgelab");
  edge(svg, mid, [[c3, f3.b], [c3, end.t]]);
  dataLab(svg, c3 + 9, 704, 1170, ["read list", "[R, 4,612] int32"]);
  edge(svg, mid, [[c4, f4.b], [c4, 1190], [end.r, 1190]]);
  dataLab(svg, c4 + 9, f4.b, 1190, ["read list", "[R, 4,612] int32"]);
}

function drawDecode() {
  var svg = $("#flow-decode"), mid = flowSvg(svg, 1100, 940);
  var c1 = 300, c2 = 800;
  var start = pill(svg, "a decode step: one index query per request, B requests", 560, 30, 520);
  edge(svg, mid, [[560, start.b], [560, 76]]);
  txt(svg, 570, 68, "new key, index query [B, 64] bf16", "edgelab");
  maintain(svg, mid, "Maintain the index, eager, before the forward");
  var mode = dn(svg, ["decode mode?"], 560, 290, 100, 36);
  edge(svg, mid, [[560, 188], [560, mode.t]]);
  dataLab(svg, 570, 188, mode.t, ["bucket centroids through pages"]);

  container(svg, 190, 352, 300, 486, "Inside the CUDA graph");
  container(svg, 690, 352, 360, 410, "Eager, outside the graph");
  edge(svg, mid, [[mode.l, 290], [c1, 290], [c1, 396]], true);
  clab(svg, 380, 282, "flat");
  edge(svg, mid, [[mode.r, 290], [c2, 290], [c2, 396]], true);
  clab(svg, 730, 282, "descend");
  txt(svg, 730, 322, "fixed, tree", "tag", "middle");

  var sa = kn(svg, "dsample", c1, 420), th = kn(svg, "dthreshold", c1, 510), sc = kn(svg, "dscan", c1, 600), od = kn(svg, "dorder", c1, 690);
  down(svg, mid, sa, th, ["sample words", "[B, n_s]"]);
  down(svg, mid, th, sc, ["threshold", "[B]"]);
  down(svg, mid, sc, od, ["staged keys", "span counts"]);
  var f1 = kn(svg, "fill", c1, 780, { unprofiled: true });
  down(svg, mid, od, f1, ["keys, bucket order", "[B, 3p] int64"]);

  var wk = kn(svg, "widekeep", c2, 420, { unprofiled: true });
  var bm = kn(svg, "beam", c2, 520, { unprofiled: true });
  down(svg, mid, wk, bm, ["kept children", "[B, 2048 x 4] int32"]);
  loopRight(svg, mid, bm, "once per level");
  var pk = kn(svg, "pick", c2, 620, { unprofiled: true });
  down(svg, mid, bm, pk, ["kept children", "[B, 2048 x 4] int32"]);
  var f2 = kn(svg, "fill", c2, 720, { unprofiled: true });
  down(svg, mid, pk, f2, ["picked buckets", "[B, p] int64"]);

  var end = pill(svg, "read list [B, 4,612] int32 -> sparse attention", 550, 900, 560);
  edge(svg, mid, [[c1, f1.b], [c1, end.t]]);
  dataLab(svg, c1 + 9, 840, end.t, ["read list", "[B, 4,612] int32"]);
  edge(svg, mid, [[c2, f2.b], [c2, end.t]]);
  dataLab(svg, c2 + 9, f2.b, end.t, ["read list", "[B, 4,612] int32"]);
}
drawFunnel();
drawPrefill();
drawDecode();

/* ---------- where the time goes ---------- */
function segStyle(si, v) {
  var c = "var(--s" + si + ")", pale = "color-mix(in srgb, " + c + " 45%, var(--panel))";
  if (v === 0) return "background:" + c;
  if (v === 1) return "background:repeating-linear-gradient(45deg," + c + " 0 6px," + pale + " 6px 12px)";
  if (v === 2) return "background:color-mix(in srgb, " + c + " 50%, var(--panel))";
  return "background:repeating-linear-gradient(-45deg," + c + " 0 3px," + pale + " 3px 6px)";
}
var BAR_PATHS = [
  { name: "Flat prefill chunk", about: "one chunk of 32,768 queries, the read", segs: [["Threshold estimate", ["samplepass", "threshold"]], ["Bucket scan", ["listing"]], ["Candidate scoring", ["listed"]], ["Expansion (by threshold)", ["fill"]]] },
  { name: "Tree prefill chunk, per level", about: "the beam step repeats once per level", segs: [["Start-level keep", ["widekeep"]], ["One beam step", ["beam"]], ["Top-p pick", ["pick"]], ["Expansion (by threshold)", ["fill"]]] },
  { name: "Flat decode step", about: "expansion is not profiled at decode, so it is left out", segs: [["Sample", ["dsample"]], ["Threshold", ["dthreshold"]], ["Scan", ["dscan"]], ["Order", ["dorder"]]] },
  { name: "Growth", about: "Ward clustering runs per closed block, node-bucket clustering per growth, so they do not always run together", segs: [["Ward clustering, per chunk", ["ward"]], ["Node-bucket clustering, per growth", ["pairing"]]] }
];
var BAR_TOTALS = {};
function drawBars() {
  var host = $("#bars");
  if (MAXCTX === null) { host.appendChild(el("p", { "class": "empty" }, ["No kernel records in this profile."])); return; }
  BAR_PATHS.forEach(function (path) {
    var segs = [], used = {};
    path.segs.forEach(function (s) {
      var ns = 0, found = false, cardId = s[1][0];
      s[1].forEach(function (id) { var t = timeAt(id, MAXCTX); if (t) { ns += t.ns; found = true; } });
      if (!found) return;
      var si = STAGE_INDEX[CARD_BY_ID[cardId].stage];
      used[si] = (used[si] === undefined ? -1 : used[si]) + 1;
      segs.push({ label: s[0], ns: ns, si: si, v: used[si] % 4, ids: s[1] });
    });
    if (!segs.length) return;
    var total = segs.reduce(function (a, s) { return a + s.ns; }, 0);
    BAR_TOTALS[path.name] = { total: total, segs: segs };
    var bar = el("div", { "class": "bar", role: "img", "aria-label": path.name + ", total " + fmtUs(total) });
    var key = el("ul", { "class": "barkey" });
    segs.forEach(function (s) {
      var d = el("div", {});
      d.style.cssText = segStyle(s.si, s.v) + ";flex:" + (s.ns / total) + " 1 0";
      attachTip(d, function () { return [s.label, path.name, ["time", fmtUs(s.ns)], ["share", pct(s.ns / total * 100)]]; });
      bar.appendChild(d);
      var sw = el("i", {});
      sw.style.cssText = segStyle(s.si, s.v);
      key.appendChild(el("li", {}, [sw, s.label, el("span", { "class": "v" }, [fmtUs(s.ns) + ", " + pct(s.ns / total * 100)])]));
    });
    host.appendChild(el("div", { "class": "barrow" }, [
      el("div", { "class": "barhead" }, [el("b", {}, [path.name]), el("span", {}, ["total " + fmtUs(total) + " - " + path.about])]),
      bar, key
    ]));
  });
  takeaways();
}
function takeaways() {
  var out = [], flat = BAR_TOTALS["Flat prefill chunk"], dec = BAR_TOTALS["Flat decode step"];
  function seg(p, label) { return p ? p.segs.filter(function (s) { return s.label === label; })[0] : null; }
  var listing = seg(flat, "Bucket scan");
  if (listing) out.push("The bucket scan is " + (listing.ns / flat.total * 100).toFixed(0) + "% of a flat chunk's read at " + ctxLabel(MAXCTX) + " (" + fmtUs(listing.ns) + " of " + fmtUs(flat.total) + ").");
  var lower = CONTEXTS.filter(function (c) { return c < MAXCTX && timeAt("listed", c); });
  var hiL = timeAt("listed", MAXCTX), loC = lower.length ? (lower.indexOf(1048576) >= 0 ? 1048576 : lower[lower.length - 1]) : null, loL = loC === null ? null : timeAt("listed", loC);
  if (hiL && loL && hiL.sm !== null && loL.sm !== null && hiL.dramPct !== null && loL.dramPct !== null) {
    var flips = loL.sm > loL.dramPct && hiL.dramPct > hiL.sm;
    out.push(flips
      ? "Candidate scoring goes from SM-bound to DRAM-bound between " + ctxLabel(loC) + " and " + ctxLabel(MAXCTX) + " (DRAM " + pct(loL.dramPct) + " -> " + pct(hiL.dramPct) + ", SM " + pct(loL.sm) + " -> " + pct(hiL.sm) + ")."
      : "Candidate scoring's DRAM throughput goes from " + pct(loL.dramPct) + " to " + pct(hiL.dramPct) + " between " + ctxLabel(loC) + " and " + ctxLabel(MAXCTX) + ".");
  }
  var scan = timeAt("dscan", MAXCTX);
  if (dec && scan && scan.gbps !== null) out.push("A decode step's select takes " + fmtUs(dec.total) + " at " + ctxLabel(MAXCTX) + ", its scan streaming " + Math.round(scan.gbps).toLocaleString("en-US") + " GB/s.");
  var gw = timeAt("ward", MAXCTX), gp = timeAt("pairing", MAXCTX);
  var sms = [gw, gp].filter(function (t) { return t && t.sm !== null; }).map(function (t) { return t.sm; });
  if (sms.length) out.push("The growth kernels are latency-bound at under " + (Math.floor(Math.max.apply(null, sms)) + 1) + "% SM" + (gw && gp ? " (Ward clustering " + pct(gw.sm) + ", node-bucket clustering " + pct(gp.sm) + ")" : "") + ".");
  var ul = $("#takeaways");
  out.forEach(function (t) { ul.appendChild(el("li", {}, [t])); });
}
drawBars();

/* ---------- the Triton kernels ---------- */
function ownKernel(k, kernels) { return kernels === "cutedsl" ? k.cutedsl : k.triton; }
var GROUPS_BY_KERNELS = { cutedsl: {}, triton: {} };
ALLK.forEach(function (k) {
  var g = GROUPS_BY_KERNELS[k.kernels], key = k.step + "@" + k.context;
  (g[key] = g[key] || []).push(k);
});
// A step's kernel replay: its own kernels' time. The reference GEMM is a torch call, so all its launches count
function replayNs(kernels, step, ctx) {
  var recs = (GROUPS_BY_KERNELS[kernels][step + "@" + ctx] || []).filter(function (k) { return k.ns !== null && (step === "reference gemm" || ownKernel(k, kernels)); });
  return recs.length ? recs.reduce(function (a, k) { return a + k.ns; }, 0) : null;
}
function wallMs(kernels, step, ctx) {
  var hit = ALLSTEPS.filter(function (s) { return s.kernels === kernels && s.step === step && s.context === ctx && s.ms !== null; })[0];
  return hit ? hit.ms : null;
}
function stepContexts(step) {
  return CONTEXTS.filter(function (c) { return wallMs("cutedsl", step, c) !== null || replayNs("cutedsl", step, c) !== null; });
}
// One Triton point per step and context: its launches summed
var TRI_POINTS = (function () {
  var out = [];
  Object.keys(GROUPS_BY_KERNELS.triton).forEach(function (key) {
    var recs = GROUPS_BY_KERNELS.triton[key].filter(function (k) { return k.triton && k.ns !== null && k.stage !== "anchor"; });
    if (!recs.length) return;
    var ns = 0, fl = 0, dram = 0, l2 = 0, pipes = { bf16: 0, tf32: 0, fp8: 0, fp32: 0 }, have = { f: false, d: false, l: false }, w = { sm: 0, mem: 0, dram: 0, l2: 0 };
    recs.forEach(function (k) {
      ns += k.ns;
      Object.keys(pipes).forEach(function (p) { pipes[p] += k.pipes[p]; });
      if (k.flops !== null) { fl += k.flops; have.f = true; }
      if (k.dramBytes !== null) { dram += k.dramBytes; have.d = true; }
      if (k.l2Bytes !== null) { l2 += k.l2Bytes; have.l = true; }
      w.sm += (k.sm || 0) * k.ns; w.mem += (k.mem || 0) * k.ns; w.dram += (k.dramPct || 0) * k.ns; w.l2 += (k.l2Pct || 0) * k.ns;
    });
    var secs = ns * 1e-9, first = recs[0];
    out.push({
      tri: true, step: first.step, stage: first.stage, context: first.context, label: "Triton " + stepName(first.step), ns: ns, launches: recs.length, pipes: pipes,
      flops: have.f ? fl : null, fps: have.f ? fl / secs : null,
      iD: have.f && have.d && dram ? fl / dram : null, iL: have.f && have.l && l2 ? fl / l2 : null,
      gbps: have.d ? dram / secs / 1e9 : null,
      sm: w.sm / ns, mem: w.mem / ns, dramPct: w.dram / ns, l2Pct: w.l2 / ns
    });
  });
  return out;
})();
function cuteNs(step, ctx) { return replayNs("cutedsl", step, ctx); }

/* ---------- cutedsl against triton ---------- */
var vs = { context: MAXCTX, mode: "replay" };
function ratioText(r) { return r >= 10 ? r.toFixed(1) + "x" : r.toFixed(2) + "x"; }
function timeTick(v) { return v >= 1e6 ? (v / 1e6) + " ms" : v >= 1e3 ? (v / 1e3) + " us" : v + " ns"; }
function vsRows() {
  var steps = Array.from(new Set(ALLSTEPS.map(function (s) { return s.step; }).concat(ALLK.map(function (k) { return k.step; })))).filter(function (n) { return n && n !== "reference gemm"; });
  var rows = [];
  function make(step) {
    var cs = stepContexts(step);
    var ctx = cs.indexOf(vs.context) >= 0 ? vs.context : (cs.length === 1 ? cs[0] : null);
    if (ctx === null) return null;
    var c = vs.mode === "replay" ? replayNs("cutedsl", step, ctx) : (wallMs("cutedsl", step, ctx) === null ? null : wallMs("cutedsl", step, ctx) * 1e6);
    var t = vs.mode === "replay" ? replayNs("triton", step, ctx) : (wallMs("triton", step, ctx) === null ? null : wallMs("triton", step, ctx) * 1e6);
    if (c === null || t === null || c <= 0) return null;
    var cr = replayNs("cutedsl", step, ctx), tr = replayNs("triton", step, ctx), cw = wallMs("cutedsl", step, ctx), tw = wallMs("triton", step, ctx);
    return { step: step, stage: STAGE_OF[step] || (ALLSTEPS.filter(function (s) { return s.step === step; })[0] || {}).stage || "prefill scan", ctx: ctx, cute: c, tri: t, ratio: t / c, cr: cr, tr: tr, cw: cw, tw: tw };
  }
  steps.forEach(function (n) { var r = make(n); if (r) rows.push(r); });
  rows.sort(function (a, b) { return b.ratio - a.ratio; });
  return { rows: rows, control: make("reference gemm") };
}
function vsName(r) { return stepName(r.step) + (r.ctx !== vs.context ? " (at " + ctxLabel(r.ctx) + ")" : ""); }
function vsSentence(rows) {
  if (!rows.length) return "No step has both languages at " + ctxLabel(vs.context) + ".";
  var tie = 0.03, wins = rows.filter(function (r) { return r.ratio >= 1 + tie; }), losses = rows.filter(function (r) { return r.ratio <= 1 - tie; }), ties = rows.filter(function (r) { return Math.abs(r.ratio - 1) < tie; });
  var best = rows[0], by = vs.mode === "replay" ? "kernel replay" : "wall time";
  function fmt(ns) { return fmtUs(ns); }
  var out = "At " + ctxLabel(vs.context) + ", by " + by + ", CuTeDSL is faster in " + wins.length + " of " + rows.length + " steps, the biggest win being " + vsName(best) + " at " + ratioText(best.ratio) + " (" + fmt(best.cute) + " against " + fmt(best.tri) + " for Triton).";
  out += losses.length ? " Triton is faster in " + losses.map(function (r) { return vsName(r) + " (" + ratioText(r.ratio) + ")"; }).join(", ") + "." : " Triton is faster in no step.";
  if (ties.length) { var names = ties.map(vsName).join(", "); out += " " + names.charAt(0).toUpperCase() + names.slice(1) + (ties.length > 1 ? " are ties" : " is a tie") + " within " + (tie * 100) + "%."; }
  return out;
}
function drawVersus() {
  var svg = $("#vs-svg"); clear(svg);
  var data = vsRows(), rows = data.rows, ctl = data.control;
  $("#vs-sentence").textContent = vsSentence(rows);
  var RH = 30, W = 960, m = { l: 230, r: 200, t: 34, b: 40 };
  var all = rows.concat(ctl ? [ctl] : []);
  var H = m.t + all.length * RH + (ctl ? 16 : 0) + m.b;
  svg.setAttribute("viewBox", "0 0 " + W + " " + H);
  if (!all.length) return emptyChart(svg, W, 120, "No step has both languages at this context");
  var vals = [];
  all.forEach(function (r) { vals.push(r.cute, r.tri); });
  var lo = Math.pow(10, Math.floor(Math.log10(Math.min.apply(null, vals)))), hi = Math.pow(10, Math.ceil(Math.log10(Math.max.apply(null, vals))));
  if (hi <= lo) hi = lo * 10;
  var X = makeScale(lo, hi, m.l, W - m.r, true);
  var yEnd = m.t + all.length * RH + (ctl ? 16 : 0);
  logTicks(lo, hi).forEach(function (v) {
    [1, 2, 5].forEach(function (f) {
      if (v * f > hi) return;
      S("line", { x1: X(v * f), x2: X(v * f), y1: m.t - 4, y2: yEnd, "class": "gridline", style: f === 1 ? "" : "opacity:0.5" }, svg);
      if (f === 1) S("text", { x: X(v * f), y: yEnd + 16, "text-anchor": "middle", "class": "tick", text: timeTick(v * f) }, svg);
    });
  });
  S("text", { x: (m.l + W - m.r) / 2, y: yEnd + 34, "text-anchor": "middle", "class": "axlab", text: (vs.mode === "replay" ? "Kernel replay time of the step" : "Median wall time of the step") + " (log scale)" }, svg);
  S("text", { x: W - m.r + 14, y: m.t - 12, "class": "axlab", text: "Triton / CuTeDSL" }, svg);
  S("text", { x: 8, y: m.t - 12, "class": "axlab", text: "Step" }, svg);
  all.forEach(function (r, i) {
    var isCtl = ctl && r === ctl;
    var y = m.t + i * RH + RH / 2 + (isCtl ? 16 : 0), si = STAGE_INDEX[r.stage], color = cssVar(si);
    if (isCtl) S("line", { x1: 8, x2: W - 8, y1: y - RH / 2 - 8, y2: y - RH / 2 - 8, "class": "anchorline" }, svg);
    S("line", { x1: 8, x2: W - 8, y1: y + RH / 2, y2: y + RH / 2, "class": "gridline", style: "opacity:0.5" }, svg);
    var gl = S("path", { d: shapePath(STAGES[si].shape, 4.5), transform: "translate(16," + y + ")", style: "fill:" + color }, svg);
    S("text", { x: 30, y: y + 4, "class": "nodetxt", text: isCtl ? "reference gemm (control)" : vsName(r) }, svg);
    var xc = X(r.cute), xt = X(r.tri);
