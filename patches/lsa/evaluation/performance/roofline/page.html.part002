    }), 2);
  }
  var sel = $("#cmp-context");
  ctxs.forEach(function (c) { sel.appendChild(el("option", { value: String(c) }, [ctxLabel(c)])); });
  if (cmp.context !== null) sel.value = String(cmp.context);
  sel.addEventListener("change", function () { cmp.context = Number(sel.value); draw(); });
  Array.prototype.forEach.call(document.querySelectorAll("input[name=cmpkernels]"), function (r) {
    r.addEventListener("change", function () { if (r.checked) { cmp.kernels = r.value; draw(); } });
  });
