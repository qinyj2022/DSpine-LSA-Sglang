    var geo = steps.length ? Math.exp(steps.reduce(function (s, r) { return s + Math.log(r.ratio); }, 0) / steps.length) : null;
    var sentence = steps.length ? "At " + ctxLabel(cmp.context) + " under kernels: " + cmp.kernels + ", " + thisLabel + " is faster than " + otherLabel + " in " + faster.length + " of " + steps.length + " steps, by " + ratioText(geo) + " in the geometric mean, the most on " + name(steps[0]) + " at " + ratioText(steps[0].ratio) + " (" + sig(steps[0].mine) + " ms against " + sig(steps[0].theirs) + " ms)." : "No step ran on both GPUs at this context.";
    if (slower.length) sentence += " " + otherLabel + " is faster on " + slower.map(function (r) { return name(r) + " (" + ratioText(r.ratio) + ")"; }).join(", ") + ".";
